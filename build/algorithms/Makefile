	cd /Users/maxbig/Coursework/build && $(MAKE) $(MAKESILENT) -f algorithms/CMakeFiles/algorithms.dir/build.make algorithms/CMakeFiles/algorithms.dir/TopologicalSort.cpp.i
.PHONY : TopologicalSort.cpp.i

TopologicalSort.s: TopologicalSort.cpp.s
.PHONY : TopologicalSort.s

# target to generate assembly for a file
TopologicalSort.cpp.s:
	cd /Users/maxbig/Coursework/build && $(MAKE) $(MAKESILENT) -f algorithms/CMakeFiles/algorithms.dir/build.make algorithms/CMakeFiles/algorithms.dir/TopologicalSort.cpp.s
.PHONY : TopologicalSort.cpp.s

